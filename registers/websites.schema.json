{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strandworks.org/schemas/websites.schema.json",
  "title": "Strandworks website and domain register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "updated_on",
    "notes",
    "sites",
    "redirect_rules",
    "links",
    "routing_export"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "updated_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "redirect_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "routing_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digital_site",
        "corporate_site",
        "legacy_default_rule"
      ],
      "properties": {
        "digital_site": {
          "type": "string",
          "minLength": 1
        },
        "corporate_site": {
          "type": "string",
          "minLength": 1
        },
        "legacy_default_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "legal_operator",
        "brand",
        "source_repo",
        "hosting",
        "canonical_url",
        "aliases",
        "visibility",
        "desired_status",
        "observed",
        "last_verification",
        "critical_paths",
        "policy_paths",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legal_operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "source_repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "hosting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "project",
            "deployment_url",
            "verification_note"
          ],
          "properties": {
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "project": {
              "type": [
                "string",
                "null"
              ]
            },
            "verification_note": {
              "type": "string",
              "minLength": 1
            },
            "deployment_url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "canonical_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private_conditional"
          ]
        },
        "desired_status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "paused",
            "private_conditional"
          ]
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "canonical_url",
            "note"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not_checked",
                "source_documented",
                "live_verified",
                "drift"
              ]
            },
            "canonical_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "last_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "method",
            "result",
            "evidence"
          ],
          "properties": {
            "at": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "not_checked",
                "source_review",
                "http_check",
                "browser_check"
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "unverified",
                "pass",
                "drift",
                "error"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "critical_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_hosts",
        "source_path",
        "target_url",
        "status_code",
        "preserve_query",
        "desired_status",
        "observed_status",
        "last_verification",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "target_url": {
          "type": "string",
          "minLength": 1
        },
        "status_code": {
          "type": "integer",
          "enum": [
            301,
            302,
            307,
            308
          ]
        },
        "preserve_query": {
          "type": "boolean"
        },
        "desired_status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "paused"
          ]
        },
        "observed_status": {
          "type": "string",
          "enum": [
            "not_checked",
            "source_documented",
            "live_verified",
            "drift"
          ]
        },
        "last_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "method",
            "result",
            "evidence"
          ],
          "properties": {
            "at": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "not_checked",
                "source_review",
                "http_check",
                "browser_check"
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "unverified",
                "pass",
                "drift",
                "error"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_site",
        "source_path",
        "target_site",
        "target_path",
        "purpose",
        "desired_status",
        "observed_status",
        "last_verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_site": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "target_site": {
          "type": "string",
          "minLength": 1
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "desired_status": {
          "type": "string",
          "enum": [
            "planned",
            "active"
          ]
        },
        "observed_status": {
          "type": "string",
          "enum": [
            "not_checked",
            "source_documented",
            "live_verified",
            "drift"
          ]
        },
        "last_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "method",
            "result",
            "evidence"
          ],
          "properties": {
            "at": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "not_checked",
                "source_review",
                "http_check",
                "browser_check"
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "unverified",
                "pass",
                "drift",
                "error"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
